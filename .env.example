# PostgreSQL (local example; replace with your own credentials)
POSTGRES_USER="moviememory"
POSTGRES_PASSWORD="replace-with-a-local-password"
POSTGRES_DB="moviememory"
DATABASE_URL="postgresql://moviememory:replace-with-a-local-password@localhost:5432/moviememory?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Google Cloud Console > OAuth Client > Web application
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Secret: server-side only. Never add NEXT_PUBLIC_ to this key.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"
